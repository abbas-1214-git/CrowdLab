# Twitch Developer Console app credentials (never expose these in VITE_* variables)
TWITCH_CLIENT_ID=your_client_id
TWITCH_CLIENT_SECRET=your_client_secret
TWITCH_REDIRECT_URI=http://localhost:3001/auth/twitch/callback
TWITCH_CHANNEL_LOGIN=your_twitch_login

# Local application settings
SERVER_PORT=3001
CLIENT_ORIGIN=http://localhost:5173
VITE_PORT=5173
VITE_SERVER_URL=http://localhost:3001
PREDICTION_MIN=-273.15
PREDICTION_MAX=1000
# Enables a clearly labeled local simulator endpoint. Keep false for a live Twitch run.
LOCAL_TEST_MODE=false
